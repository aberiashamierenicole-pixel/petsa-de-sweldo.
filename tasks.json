{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: build",
      "type": "shell",
      "command": "${workspaceFolder}/backend/scripts/build.sh",
      "windows": { "command": "${workspaceFolder}\\backend\\scripts\\build.bat" },
      "group": "build"
    },
    {
      "label": "Backend: run API",
      "type": "shell",
      "command": "${workspaceFolder}/backend/scripts/run.sh",
      "windows": { "command": "${workspaceFolder}\\backend\\scripts\\run.bat" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: run dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run everything (API + UI)",
      "dependsOn": ["Backend: run API", "Frontend: run dev server"],
      "problemMatcher": []
    }
  ]
}
